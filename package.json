{
  "name": "aero-world",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "preview:local": "vite preview --host 127.0.0.1 --port 3000 --strictPort",
    "start:local": "npm run build && npm run preview:local",
    "test": "node --test tests/*.test.js",
    "test:mobile": "npm run build && node tests/mobile-server.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^8.32.0",
    "@dgreenheck/ez-tree": "^1.1.0",
    "phaser": "3.90.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "vite": "^7.1.9"
  }
}
